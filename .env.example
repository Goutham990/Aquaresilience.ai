# Copy to .env. Set the operator key to a long random secret (e.g. openssl rand -hex 32).
DATABASE_URL=postgresql://aqua:aqua@localhost:5432/aqua
OPERATOR_API_KEY=CHANGE_ME_TO_RANDOM_SECRET
# Optional: Without this, deterministic evidence-only briefing remains enabled.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# For development/demo ONLY. Self-host OSRM for production.
OSRM_BASE=https://router.project-osrm.org
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE=http://localhost:8000
